<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="DownloadX"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="neko233-com"
           UpgradeCode="F7253FB4-CC8C-449F-B7CD-39DA557D76AE">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of DownloadX is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="DownloadX.ico" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="DownloadX.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/neko233-com/DownloadX" />

    <UIRef Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseFile)" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="SystemFolder" />
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="DownloadX" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="DownloadX" />
      </Directory>
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="DownloadXCLI" Guid="77269FA7-71C9-483E-ACE1-ACBD5C9EACB2" Win64="yes">
        <File Id="DownloadXExe" Name="downloadx.exe"
              Source="$(var.PayloadDir)\downloadx.exe" />
        <RegistryValue Root="HKLM" Key="Software\neko233-com\DownloadX"
                       Name="downloadx" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      </Component>
      <Component Id="DownloadXGUI" Guid="781D8092-0B1A-451E-964E-22BFE05D1A10" Win64="yes">
        <File Id="DownloadXGuiExe" Name="downloadx-gui.exe"
              Source="$(var.PayloadDir)\downloadx-gui.exe" />
        <RegistryValue Root="HKLM" Key="Software\neko233-com\DownloadX"
                       Name="downloadx-gui" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="DownloadXHost" Guid="7BF591C0-4D81-40FC-AB66-100EE3E6AD1A" Win64="yes">
        <File Id="DownloadXHostExe" Name="downloadx-host.exe"
              Source="$(var.PayloadDir)\downloadx-host.exe" KeyPath="yes" />
      </Component>
      <Component Id="DownloadXIcon" Guid="452E4CDE-609D-4E4B-A254-6997E87CD89D" Win64="yes">
        <File Id="DownloadXIconFile" Name="downloadx.ico"
              Source="$(var.IconFile)" KeyPath="yes" />
      </Component>
      <Component Id="NativeHostManifest" Guid="40818CD1-928E-4082-9AB4-06AD9856CEAC" Win64="yes">
        <File Id="NativeHostManifestFile" Name="com.neko233.downloadx.json"
              Source="$(var.ManifestFile)" KeyPath="yes" />
      </Component>
      <Component Id="NativeHostRegistration" Guid="405E5620-DEE7-4116-A237-7ED24A89026F" Win64="yes">
        <RegistryKey Root="HKLM" Key="SOFTWARE\Google\Chrome\NativeMessagingHosts\com.neko233.downloadx">
          <RegistryValue Type="string" Value="[INSTALLFOLDER]com.neko233.downloadx.json" KeyPath="yes" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Edge\NativeMessagingHosts\com.neko233.downloadx">
          <RegistryValue Type="string" Value="[INSTALLFOLDER]com.neko233.downloadx.json" />
        </RegistryKey>
      </Component>
      <Component Id="ChromeExternalExtension" Guid="F7805A05-B0DA-4F10-BFBB-1596D8E2B9E7" Win64="yes">
        <RegistryKey Root="HKLM" Key="SOFTWARE\Google\Chrome\Extensions\pdlpjmbjgipkbjekncinhchgbahpgbng">
          <RegistryValue Name="update_url" Type="string"
                         Value="https://cdn.jsdelivr.net/gh/neko233-com/DownloadX@main/docs/extension/updates.xml"
                         KeyPath="yes" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="SOFTWARE\Wow6432Node\Google\Chrome\Extensions\pdlpjmbjgipkbjekncinhchgbahpgbng">
          <RegistryValue Name="update_url" Type="string"
                         Value="https://cdn.jsdelivr.net/gh/neko233-com/DownloadX@main/docs/extension/updates.xml" />
        </RegistryKey>
      </Component>
      <Component Id="EdgeExternalExtension" Guid="614C65C1-7FC5-4CDC-A564-BD883D7006C3" Win64="yes">
        <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Edge\Extensions\pdlpjmbjgipkbjekncinhchgbahpgbng">
          <RegistryValue Name="update_url" Type="string"
                         Value="https://cdn.jsdelivr.net/gh/neko233-com/DownloadX@main/docs/extension/updates.xml"
                         KeyPath="yes" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="SOFTWARE\WOW6432Node\Microsoft\Edge\Extensions\pdlpjmbjgipkbjekncinhchgbahpgbng">
          <RegistryValue Name="update_url" Type="string"
                         Value="https://cdn.jsdelivr.net/gh/neko233-com/DownloadX@main/docs/extension/updates.xml" />
        </RegistryKey>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="5B2F72C3-DCB7-431B-A1C7-D6AD5E648DE8">
        <File Id="StartMenuShortcutFile" Name="DownloadX.lnk"
              Source="$(var.ShortcutFile)" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\neko233-com\DownloadX"
                       Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="MainFeature" Title="DownloadX" Level="1">
      <ComponentRef Id="DownloadXCLI" />
      <ComponentRef Id="DownloadXGUI" />
      <ComponentRef Id="DownloadXHost" />
      <ComponentRef Id="DownloadXIcon" />
      <ComponentRef Id="NativeHostManifest" />
      <ComponentRef Id="NativeHostRegistration" />
      <ComponentRef Id="ChromeExternalExtension" />
      <ComponentRef Id="EdgeExternalExtension" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <CustomAction Id="ClearShortcutNotContentIndexed"
                  Directory="SystemFolder"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"
                  ExeCommand='cmd.exe /c attrib -I +A "%ProgramData%\Microsoft\Windows\Start Menu\Programs\DownloadX" &amp; attrib -I +A "%ProgramData%\Microsoft\Windows\Start Menu\Programs\DownloadX\DownloadX.lnk"' />
    <InstallExecuteSequence>
      <Custom Action="ClearShortcutNotContentIndexed" After="CreateShortcuts">NOT REMOVE</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
